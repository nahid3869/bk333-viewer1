<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_background">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swProxyMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 Proxy Mode (Bypass X-Frame)"
        android:textColor="@color/text_primary"
        android:checked="true"
        android:paddingVertical="8dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swNightMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌙 Dark / Night Mode"
        android:textColor="@color/text_primary"
        android:paddingVertical="8dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swDesktopUA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💻 Desktop User-Agent"
        android:textColor="@color/text_primary"
        android:checked="true"
        android:paddingVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ Proxy Mode ব্যবহার করে BK333 সাইট X-Frame-Options বাইপাস করে লোড হবে"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:paddingTop="12dp"/>

</LinearLayout>
